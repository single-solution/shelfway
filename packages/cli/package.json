{
	"name": "@shelfway/cli",
	"version": "0.2.0",
	"description": "Developer CLI for Shelfway products: shelfway app init, shelfway app validate, shelfway app assets.",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"templates"
	],
	"bin": {
		"shelfway": "./src/bin.js"
	},
	"engines": {
		"node": "22.x"
	},
	"publishConfig": {
		"access": "restricted"
	},
	"prettier": "@shelfway/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@shelfway/app-kit": "workspace:^",
		"@shelfway/contracts": "workspace:^",
		"esbuild": "^0.28.2"
	},
	"devDependencies": {
		"@shelfway/config": "workspace:^",
		"@shelfway/ui": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"jsdom": "^26.1.0",
		"mongodb": "^6.21.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
