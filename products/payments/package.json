{
	"name": "@shelfway/product-payments",
	"version": "0.1.0",
	"description": "Payments: online payments with the merchant's own gateway keys \u2014 Stripe, PayPal, PayFast (South Africa), PayFast (Pakistan), JazzCash (Pakistan), Easypaisa (Pakistan), Rapid Gateway (Pakistan), custom gateways of the merchant's own and manual payment methods; payment links, the payment API, gateway-managed subscriptions and refunds (PLAN 0.8.7).",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"exports": {
		"./product": "./adapters/product.js",
		"./routes": "./server/routes.js",
		"./package.json": "./package.json"
	},
	"engines": {
		"node": "22.x"
	},
	"prettier": "@shelfway/config/prettier.json",
	"scripts": {
		"dev": "shelfway app assets . && next dev --port 3004",
		"build": "shelfway app assets . && next build",
		"start": "next start --port 3004",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "shelfway app validate ."
	},
	"dependencies": {
		"@shelfway/app-kit": "workspace:^",
		"@shelfway/contracts": "workspace:^",
		"@shelfway/net": "workspace:^",
		"@shelfway/protocol": "workspace:^",
		"@shelfway/ui": "workspace:^",
		"mongodb": "^6.21.0",
		"next": "~16.3.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@shelfway/cli": "workspace:^",
		"@shelfway/config": "workspace:^",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"jsdom": "^26.1.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
