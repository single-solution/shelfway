{
	"name": "@shelfway/e2e",
	"version": "0.1.0",
	"description": "System tests: products against the REAL Portal, in process (the Portal from @shelfway/platform/testing), on one MongoMemoryReplSet.",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": "22.x"
	},
	"prettier": "@shelfway/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate && pnpm test",
		"test": "vitest run",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"validate": "shelfway app validate fixtures/notes",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@shelfway/app-kit": "workspace:^",
		"@shelfway/cli": "workspace:^",
		"@shelfway/config": "workspace:^",
		"@shelfway/contracts": "workspace:^",
		"@shelfway/importer": "workspace:^",
		"@shelfway/platform": "workspace:^",
		"@shelfway/product-accounts": "workspace:^",
		"@shelfway/product-chat": "workspace:^",
		"@shelfway/product-ecommerce": "workspace:^",
		"@shelfway/product-growth": "workspace:^",
		"@shelfway/product-notifications": "workspace:^",
		"@shelfway/product-payments": "workspace:^",
		"@shelfway/protocol": "workspace:^",
		"@shelfway/ui": "workspace:^",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"bcryptjs": "^3.0.3",
		"eslint": "^9.39.5",
		"jsdom": "^26.1.0",
		"mongodb": "^6.21.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
