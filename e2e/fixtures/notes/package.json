{
	"name": "@shelfway/product-notes",
	"version": "0.1.0",
	"description": "Notes: a Shelfway product (widgets and API).",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"exports": {
		"./product": "./adapters/product.js",
		"./routes": "./server/routes.js",
		"./package.json": "./package.json"
	},
	"engines": {
		"node": "22.x"
	},
	"prettier": "@shelfway/config/prettier.json",
	"scripts": {
		"dev": "shelfway app assets . && next dev --port 3007",
		"build": "shelfway app assets . && next build",
		"start": "next start --port 3007",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "shelfway app validate ."
	},
	"dependencies": {
		"@shelfway/app-kit": "workspace:^",
		"@shelfway/contracts": "workspace:^",
		"@shelfway/ui": "workspace:^",
		"mongodb": "^6.21.0",
		"next": "~16.3.8",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@shelfway/cli": "workspace:^",
		"@shelfway/config": "workspace:^",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"jsdom": "^26.1.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
